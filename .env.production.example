# Copie este arquivo para .env na RAIZ do app no servidor cPanel.
# Não use o .env local (DEBUG=True / localhost).

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=altere-esta-chave-no-servidor
DJANGO_DEBUG=False
DJANGO_SHOW_DEMO_PROFILES=True
DJANGO_ALLOWED_HOSTS=edu.innomove.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://edu.innomove.com.br

# MVP: SQLite no disco do app. Troque por MySQL do cPanel se preferir:
# DATABASE_URL=mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO
DATABASE_URL=sqlite:///db.sqlite3
